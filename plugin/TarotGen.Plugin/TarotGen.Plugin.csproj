<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!--
    The Dalamud.NET.Sdk pulls in the Dalamud assemblies, ImGui bindings, Lumina,
    FFXIVClientStructs and DalamudPackager automatically. Building requires the
    Dalamud dev distribution to be present (XIVLauncher installs it to
    %AppData%\XIVLauncher\addon\Hooks\dev). Open in VS 2026 / Rider with the
    Dalamud dev environment; `dotnet build` alone (without Dalamud present) will
    not resolve the Dalamud references.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- CI builds on Linux (with DALAMUD_HOME); a Windows target needs this there. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TarotGen.Plugin</AssemblyName>
    <RootNamespace>TarotGen.Plugin</RootNamespace>
    <Version>0.8.0</Version>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every build runs the recommended .NET analyzers and the .editorconfig
         style rules, and any warning fails it (AUDIT §6.3). Vulnerability
         advisories on packages stay warnings: one landing on a Dalamud
         dependency shouldn't block a release; Dependabot raises the update. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Ship the manifest alongside the DLL for DalamudPackager. -->
  <ItemGroup>
    <None Include="TarotGen.Plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Windows DPAPI for at-rest token encryption (bundled by DalamudPackager). -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
</Project>
