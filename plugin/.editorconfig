# The Dalamud plugin's C# conventions, as every file already follows them.
# Charset, line endings and whitespace come from the root .editorconfig.

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_new_line_before_open_brace = all

[*.{csproj,props,targets}]
indent_size = 2

# Visual Studio writes solution files with tabs.
[*.sln]
indent_style = tab
