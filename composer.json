{
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.5.6"
        }
    },
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "lbuchs/webauthn": "^2.2",
        "php-di/slim-bridge": "*",
        "phpmailer/phpmailer": "^6.9",
        "slim/http": "*",
        "slim/psr7": "*",
        "slim/slim": "*"
    },
    "autoload": {
        "psr-4": {
            "Tarot\\": "includes/Tarot",
            "Routes\\": "api/Routes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tarot\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "*",
        "friendsofphp/php-cs-fixer": "*",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
