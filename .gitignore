# Backend (PHP) — generated deps, server-side data, local config
/backend/vendor/
/backend/assets/
# Ignore the live DB + one-off migration scripts, but keep the committed schema.
/backend/db/*
!/backend/db/schema.sql
/backend/.phpunit.cache/
/backend/.env

# Frontend (Vue) — generated deps + build output, private registry token
/frontend/node_modules/
/frontend/dist/
# Holds the FontAwesome private-registry auth token — never commit.
/frontend/.npmrc

# Local deploy settings (server IP, SSH key path, web root) — never commit.
# Copy scripts/deploy.config.example.ps1 to create it.
/scripts/deploy.config.ps1

# Editor / agent — repo-level
/.idea/
/.vscode/
/.claude/
/AGENTS.md

# Catch any stray .env anywhere
.env

# Python bytecode (scripts/*.py)
__pycache__/
*.pyc

# OS / editor cruft (this tree lives under OneDrive on Windows)
.DS_Store
Thumbs.db
Desktop.ini
