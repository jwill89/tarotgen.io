{
  "name": "tarot-site",
  "private": true,
  "version": "5.4.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss,vue}\"",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gen:types": "npx --yes openapi-typescript@^7 ../backend/openapi.json -o src/types/api.generated.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/pro-duotone-svg-icons": "^7.0.0",
    "@fortawesome/pro-regular-svg-icons": "^7.0.0",
    "@fortawesome/pro-solid-svg-icons": "^7.0.0",
    "@fortawesome/vue-fontawesome": "^3.3.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "bulma": "^1.0.4",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "reka-ui": "^2.10.1",
    "turndown": "^7.2.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@jwill89/eslint-config": "file:eslint-config",
    "@playwright/test": "^1.64.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.6.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.43.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^13.0.0"
    }
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.6.0": true
  }
}
