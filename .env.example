# Admin access is gated by a user account with the is_admin flag (set one with
# `php scripts/make_admin.php you@example.com`). There is no shared admin
# password anymore.

# Set to "production" in live environments. This disables detailed error
# output (no stack traces leaked) and enables the Secure flag on session cookies.
APP_ENV=development

# Optional: allowed cross-origin for the API. Leave blank for same-origin only.
# When set, credentialed CORS is enabled for exactly this origin (never "*").
APP_ORIGIN=

# Public base URL of the site, used to build links in emails (e.g. account
# activation). No trailing slash. Defaults to https://tarotgen.io when unset.
APP_URL=https://tarotgen.io

# ── IndexNow (instant search-engine recrawl: Bing, Yandex, DuckDuckGo) ────
# Key used to submit changed URLs to IndexNow. A matching key file must be
# hosted at the site root (public/<key>.txt) so engines can verify ownership.
# Leave blank to disable; submissions then become a graceful no-op.
# Submit URLs with: php scripts/indexnow.php
INDEXNOW_KEY=423fdd492191b1b7806110126f629979

# ── Email (account activation, password resets) ──────────────────────────
# SMTP transport for transactional email via PHPMailer. When SMTP_HOST is
# blank, email sending is skipped (and, outside production, the activation link
# is returned in the API response so sign-up still works in dev).
#
# Google Workspace SMTP relay: SMTP_HOST=smtp-relay.gmail.com lets you send as
# any address in your domain (e.g. noreply@tarotgen.io). If the relay is set to
# "Require SMTP Authentication", set SMTP_USER/SMTP_PASS to a Workspace user +
# App Password; if it authenticates by IP allowlist instead, leave them blank.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 'tls' for STARTTLS (port 587) or 'ssl' for implicit TLS (port 465).
SMTP_SECURE=tls
# From address/name for outgoing mail (defaults to SMTP_USER / "TarotGen.io").
MAIL_FROM=noreply@tarotgen.io
MAIL_FROM_NAME=TarotGen.io

# ── Google OAuth (optional: sign in / register with Google) ──────────────
# Create credentials at https://console.cloud.google.com/apis/credentials.
# The redirect URI must be: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tarotgen.io/api/auth/google/callback
