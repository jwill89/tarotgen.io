# TarotGen.io scheduled jobs. Installed on the droplet as /etc/cron.d/tarotgen
# (root:root 644, LF line endings — cron silently ignores a malformed file).
# Source: scripts/server/tarotgen.cron in the repo.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TAROT_DATA_DIR=/var/lib/tarotgen

# 03:17 UTC nightly: online backup of the database, newest 14 kept
# (/var/backups/tarotgen/nightly). Output goes to syslog: journalctl -t tarotgen-backup
# Then, only if that backup succeeded, data retention (AUDIT.md §1.7): guest
# readings older than a year are deleted, as the privacy policy states, and the
# planner statistics refreshed. Output: journalctl -t tarotgen-retention
17 3 * * * root /usr/local/sbin/tarotgen-backup >/dev/null 2>&1 && runuser -u www-data -- php /var/www/tarotgen.io/scripts/retention.php 2>&1 | logger -t tarotgen-retention
