<?xml version="1.0" encoding="UTF-8"?>
<!-- Lives in config/; paths are relative to this file, hence the ../ prefixes.
     Run via `composer test` (which passes -c config/phpunit.xml). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         cacheDirectory="../.phpunit.cache"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true">
    <testsuites>
        <testsuite name="unit">
            <directory>../tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../includes/Tarot</directory>
            <directory>../api/Routes</directory>
        </include>
    </source>
</phpunit>
