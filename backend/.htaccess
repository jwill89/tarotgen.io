# Security headers for the app shell / static responses (the API sets its own in
# api/index.php). Guarded so a host without mod_headers doesn't 500.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content-Security-Policy, rolled out in Report-Only mode first: browsers
    # REPORT violations to the console but never block, so this can't break the
    # live SPA, Cloudflare Turnstile, or Google Fonts. After watching for false
    # positives, promote it by renaming the header to "Content-Security-Policy".
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

    # Vite writes content-hashed filenames into /_app/ (assetsDir), so the bytes
    # behind a given URL never change — a new build means a new URL. Say so, or
    # the origin sends nothing and Cloudflare's default 4-hour Browser Cache TTL
    # applies: returning visitors re-download the whole bundle (and sit through
    # the boot loader again) roughly twice a day.
    SetEnvIf Request_URI "^/_app/" TG_HASHED_ASSET
    Header always set Cache-Control "public, max-age=31536000, immutable" env=TG_HASHED_ASSET

    # Fonts are NOT hashed, so they can't claim immutability — but they change
    # about never, and a month keeps them off the critical path for repeat visits.
    SetEnvIf Request_URI "^/fonts/" TG_FONT
    Header always set Cache-Control "public, max-age=2592000" env=TG_FONT

    # Card scans and the other /assets/ images keep their URL when replaced, so
    # they can't be immutable — but they change only on a re-scan, and a full
    # card is ~5 MB of PNG. Cloudflare may hold them 30 days (s-maxage), browsers
    # a day. After replacing an image, purge its URL in Cloudflare; browsers pick
    # it up within 24 h. `set` without `always` applies to successful responses
    # only, so a missing image is never pinned at the edge for a month.
    SetEnvIf Request_URI "^/assets/" TG_ASSET
    Header set Cache-Control "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800" env=TG_ASSET
</IfModule>

RewriteEngine On

# Server-side files share the web root with the app (the deploy flattens
# backend/ into it), so refuse them before anything else. Without these rules
# the "existing files" rule below serves the SQLite database and .env verbatim,
# and Apache executes any .php under db/, includes/, vendor/ or scripts/ by URL.
RewriteRule ^(db|includes|vendor|scripts|\.deploy)(/|$) - [R=404,L]
RewriteRule ^(\.env.*|composer\.(json|lock)|openapi\.json)$ - [R=404,L]

# API requests — handled by api/.htaccess
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# Existing files served directly (card images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Built assets in dist/ (Vite JS/CSS bundles)
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ dist/$1 [L]

# Shared reading links: serve the built app shell with per-reading social meta
# injected server-side (the SPA still hydrates as normal for visitors).
RewriteRule ^reading/[A-Za-z0-9]+/?$ og.php [L]

# Static file trees (/plugin/*, /assets/*): a missing file here MUST 404, never
# fall through to the SPA shell below. Existing files were already served by the
# -f rule above, so anything reaching this point is genuinely missing. Returning
# 200-HTML instead would make Dalamud download the app shell in place of the
# plugin zip ("Download failed"), and hand <img> tags an HTML page for a card
# scan — and because these URLs end in .zip/.png/.webp, Cloudflare CACHES that
# 200-HTML for hours (max-age=14400), so the real file stays hidden behind it
# after upload. A 404 is not long-cached and self-heals once the file exists.
RewriteCond %{REQUEST_URI} ^/(plugin|assets)/
RewriteRule ^ - [R=404,L]

# SPA fallback — serve the built app
RewriteRule ^ dist/index.html [L]
