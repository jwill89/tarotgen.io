# Security headers for the app shell / static responses (the API sets its own in
# api/index.php). Guarded so a host without mod_headers doesn't 500.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # No Content-Security-Policy here: it is set per response by PHP, because it
    # needs a fresh nonce each time (og.php → Tarot\Utility\ContentSecurityPolicy;
    # /api/docs sends its own). Only HTML documents need one, and every page now
    # goes through og.php — see the SPA fallback at the bottom (AUDIT §1.5).

    # /_app/ and /fonts/ are served by an internal rewrite into dist/ (below), so
    # these match on the FILE being served, not the URL: a `SetEnvIf Request_URI
    # "^/_app/"` rule never matched the rewritten request, and these headers were
    # silently never sent.

    # Vite writes content-hashed filenames into /_app/ (assetsDir), so the bytes
    # behind a given URL never change — a new build means a new URL. Say so, or
    # Cloudflare's default 4-hour Browser Cache TTL applies: returning visitors
    # re-download the whole bundle (and sit through the boot loader again)
    # roughly twice a day.
    <If "%{REQUEST_FILENAME} =~ m#/dist/_app/#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # Fonts are NOT hashed, so they can't claim immutability — but they change
    # about never, and a month keeps them off the critical path for repeat visits.
    <If "%{REQUEST_FILENAME} =~ m#/dist/fonts/#">
        Header always set Cache-Control "public, max-age=2592000"
    </If>

    # The HTML shell (served by og.php for every page; index.html if ever hit
    # directly) must be revalidated on every load — and it now carries a
    # per-response CSP nonce: it names the hashed bundles of ONE build, and a
    # deploy deletes the previous build's files. Left to heuristic caching, a
    # returning browser could boot a stale shell that requests bundles which no
    # longer exist — a blank app until a hard refresh.
    <FilesMatch "^(index\.html|og\.php)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>

    # Card scans and the other /assets/ images keep their URL when replaced, so
    # they can't be immutable — but they change only on a re-scan, and a full
    # card is ~5 MB of PNG. Cloudflare may hold them 30 days (s-maxage), browsers
    # a day. After replacing an image, purge its URL in Cloudflare; browsers pick
    # it up within 24 h. `set` without `always` applies to successful responses
    # only, so a missing image is never pinned at the edge for a month.
    SetEnvIf Request_URI "^/assets/" TG_ASSET
    Header set Cache-Control "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800" env=TG_ASSET
</IfModule>

RewriteEngine On

# Server-side files share the web root with the app (the deploy flattens
# backend/ into it), so refuse them before anything else. Without these rules
# the "existing files" rule below serves the SQLite database and .env verbatim,
# and Apache executes any .php under db/, includes/, vendor/ or scripts/ by URL.
RewriteRule ^(db|includes|vendor|scripts|\.deploy)(/|$) - [R=404,L]
RewriteRule ^(\.env.*|composer\.(json|lock)|openapi\.json)$ - [R=404,L]

# API requests — handled by api/.htaccess
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# The shell is only ever served by og.php, which attaches the CSP. Served as a
# static file (/index.html via the dist rule, /dist/index.html via the -f rule)
# it would load the whole app with no policy — a ready-made CSP bypass link.
RewriteRule ^(dist/)?index\.html$ og.php [L]

# Existing files served directly (card images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Built assets in dist/ (Vite JS/CSS bundles)
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ dist/$1 [L]


# Static file trees (/plugin/*, /assets/*, /_app/*, /fonts/*): a missing file
# here MUST 404, never fall through to the SPA shell below. Existing files were
# already served by the -f / dist rules above, so anything reaching this point
# is genuinely missing. Returning 200-HTML instead would make Dalamud download
# the app shell in place of the plugin zip ("Download failed"), hand <img> tags
# an HTML page for a card scan, and feed a stale tab's lazy import() HTML for a
# deleted chunk — and because these URLs end in .zip/.png/.js, Cloudflare CACHES
# that 200-HTML for hours (max-age=14400), hiding the real file behind it. A 404
# is not long-cached and self-heals once the file exists.
RewriteCond %{REQUEST_URI} ^/(plugin|assets|_app|fonts)/
RewriteRule ^ - [R=404,L]

# SPA fallback — every page route. og.php serves the built shell with a fresh
# CSP nonce (and, for /reading/{id}, that reading's social meta).
RewriteRule ^ og.php [L]
