parameters:
	ignoreErrors:
		-
			message: '#^Method Tarot\\Utility\\DbSessionHandler\:\:read\(\) never returns false so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: includes/Tarot/Utility/DbSessionHandler.php

		-
			message: '#^Call to function is_array\(\) with array\{count\: int, first\: int\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: includes/Tarot/Utility/RateLimiter.php

		-
			message: '#^Offset ''first'' on array\{count\: int, first\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: includes/Tarot/Utility/RateLimiter.php
