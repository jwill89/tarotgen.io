{
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "lbuchs/webauthn": "^2.2",
        "php-di/php-di": "^7.1",
        "phpmailer/phpmailer": "^7.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "slim/http": "^1.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9.7",
        "maglnet/composer-require-checker": "^4.24",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.6",
        "roave/security-advisories": "dev-latest",
        "zircote/swagger-php": "^7.0"
    },
    "conflict": {
        "phpstan/phpstan": ">2.3.3"
    },
    "autoload": {
        "psr-4": {
            "Routes\\": "api/Routes",
            "Tarot\\": "includes/Tarot"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tarot\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.12"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "deps:check": [
            "composer-unused --no-progress",
            "composer-require-checker check composer.json --config-file=composer-require-checker.json"
        ],
        "dev": "php -S localhost:80 dev-router.php",
        "docs": "@php bin/openapi.php",
        "lint": "php-cs-fixer check --show-progress=none",
        "lint:fix": "php-cs-fixer fix",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:coverage": [
            "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover .phpunit.cache/clover.xml --coverage-text --only-summary-for-coverage-text",
            "@php bin/coverage-check.php .phpunit.cache/clover.xml"
        ]
    }
}
