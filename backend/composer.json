{
    "license": "proprietary",
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.5.12"
        }
    },
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "lbuchs/webauthn": "^2.2",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4",
        "phpmailer/phpmailer": "^7.0",
        "slim/http": "^1.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "autoload": {
        "psr-4": {
            "Tarot\\": "includes/Tarot",
            "Routes\\": "api/Routes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tarot\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.0",
        "roave/security-advisories": "dev-latest",
        "zircote/swagger-php": "^6.0"
    },
    "scripts": {
        "dev": "php -S localhost:80 dev-router.php",
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "lint": "php-cs-fixer check --show-progress=none",
        "lint:fix": "php-cs-fixer fix",
        "docs": "openapi api includes --version 3.1.0 --format json --add-processor \"Routes\\RequireStructureProperties\" --output openapi.json"
    }
}
