{
    "license": "proprietary",
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.5.6"
        }
    },
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "lbuchs/webauthn": "^2.2",
        "php-di/slim-bridge": "*",
        "phpmailer/phpmailer": "^7.0",
        "slim/http": "*",
        "slim/psr7": "*",
        "slim/slim": "*"
    },
    "autoload": {
        "psr-4": {
            "Tarot\\": "includes/Tarot",
            "Routes\\": "api/Routes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tarot\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "*",
        "zircote/swagger-php": "^6.0"
    },
    "scripts": {
        "dev": "php -S localhost:80 dev-router.php",
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "lint:fix": "php-cs-fixer fix",
        "docs": "openapi api includes --version 3.1.0 --format json --output openapi.json"
    }
}
